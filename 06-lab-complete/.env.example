# ============================================================
# Biến môi trường của agent. KHÔNG ghi secret thật vào file này.
# Dùng: cp .env.example .env  (file .env đã nằm trong .gitignore)
# Trên Railway / Render: đặt các biến này trong dashboard / CLI.
# ============================================================

# Server
PORT=8000
# development | staging | production
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_VERSION=1.0.0
# số uvicorn worker trong Docker
WEB_CONCURRENCY=2

# Security — bắt buộc khi ENVIRONMENT=production
# Tạo key: python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_API_KEY=

# State (rate limit + cost guard)
REDIS_URL=redis://localhost:6379/0

# Rate limit: số request / 60 giây cho mỗi API key
RATE_LIMIT_PER_MINUTE=10

# Cost guard (USD): vượt một trong hai ngưỡng → 402
DAILY_BUDGET_USD=1.0
MONTHLY_BUDGET_USD=10.0
